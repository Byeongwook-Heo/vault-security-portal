AWS_REGION=ap-northeast-2
PROJECT_NAME=security-portal
ENVIRONMENT=test

# Build and push images before full ECS deployment.
FRONTEND_IMAGE_URI=
BACKEND_IMAGE_URI=

# Phase 1 deploys with mock Vault.
VAULT_MODE=mock
VAULT_ADDR=
VAULT_NAMESPACE=
VAULT_AUTH_MODE=mock
VAULT_APPROLE_AUTH_MOUNT=approle
VAULT_USE_SYSTEM_NAMESPACE=false
VAULT_REQUEST_TIMEOUT_MS=10000

# Optional public entrypoint settings.
ALB_INTERNAL=false
ALLOWED_INGRESS_CIDRS=["0.0.0.0/0"]
