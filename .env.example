NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://security_portal:security_portal@postgres:5432/security_portal
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=sp_user

# Phase 1 defaults to mock Vault. Real Vault is introduced in Phase 2.
VAULT_MODE=mock
VAULT_ADDR=
VAULT_NAMESPACE=
VAULT_AUTH_MODE=mock
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_APPROLE_AUTH_MOUNT=approle
VAULT_AWS_AUTH_ROLE=
VAULT_SKIP_VERIFY=false
VAULT_USE_SYSTEM_NAMESPACE=false
VAULT_REQUEST_TIMEOUT_MS=10000

# Plugin Factory assistant. Rules mode is the local no-inference fallback.
LLM_MODE=rules
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b
OLLAMA_API_KEY=
OLLAMA_REQUEST_TIMEOUT_MS=90000

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://localhost:4000
