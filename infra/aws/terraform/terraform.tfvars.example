aws_region   = "ap-northeast-2"
project_name = "security-portal"
environment  = "test"

create_new_network = true
availability_zones = ["ap-northeast-2a", "ap-northeast-2c"]
vpc_cidr           = "10.70.0.0/16"
enable_nat_gateway = true

allowed_ingress_cidrs = ["0.0.0.0/0"]
alb_internal          = false
desired_count         = 0

# Optional private GPU inference service for Plugin Factory chat.
enable_ollama        = false
ollama_ami_id        = ""
ollama_instance_type = "g6.xlarge"
ollama_model         = "qwen3:8b"

vault_mode      = "mock"
vault_auth_mode = "mock"
vault_addr      = ""
vault_namespace = ""

# Provision the private real-Vault path first. Populate the four AppRole secret
# containers, then set enable_real_vault_runtime=true in a second apply.
provision_real_vault_integration = false
enable_real_vault_runtime        = false

# vault_vpc_id              = "vpc-..."
# vault_vpc_cidr            = "10.40.0.0/16"
# vault_subnet_ids          = ["subnet-...", "subnet-..."]
# vault_route_table_ids     = ["rtb-...", "rtb-..."]
# vault_security_group_id   = "sg-..."
# vault_instance_ids        = ["i-...", "i-...", "i-..."]
# vault_node_iam_role_name  = "vault-node-role"
# vault_plugin_allowed_mount_prefix = "factory-lab"
# vault_plugin_directory    = "/opt/vault/plugins"
